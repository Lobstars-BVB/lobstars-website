---
import ContentContainer from "./ContentContainer.astro";

interface Props {
  title: string;
  address: string;
  place: string;
  openMapURL: string;
  openMapIframeSrc: string;
  googleMapURL: string;
  day?: string;
  time?: string;
}

const {
  title,
  day,
  time,
  address,
  place,
  openMapURL,
  openMapIframeSrc,
  googleMapURL,
} = Astro.props;
---

<div class="space-y-4">
  <h2 class="text-2xl font-bold text-neon-pink-dark">{title}</h2>
  <div class="text-main space-y-2 font-medium">
    <div>
      {
        time && day ? (
          <p>
            <b>When:</b> {day}
            <br />
            <a href="#training-note">
              <b>Time:</b>
              <span class="underline">{time}</span> *
            </a>
          </p>
        ) : (
          <p class="italic ">
            Contact us through the{" "}
            <a href="#contact" class="underline hover:no-underline">
              contact form
            </a>{" "}
            for more information
            <br />
            <br />
          </p>
        )
      }
    </div>
    <div>
      <p>{place}</p>
      <p>{address}</p>
    </div>
  </div>
  <ContentContainer>
    <iframe
      src={openMapIframeSrc}
      width="100%"
      height="300px"
      title=`Map of ${place} at ${address}`></iframe>
  </ContentContainer>
  <div class="space-y-2 font-medium">
    <p>
      <a
        class="text-neon-pink-dark underline"
        target="_blank"
        rel="noopener noreferrer"
        href={openMapURL}>Open Street Map</a
      >
    </p>
    <p>
      <a
        class="text-neon-pink-dark underline"
        href={googleMapURL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Google Map
      </a>
    </p>
  </div>
</div>
