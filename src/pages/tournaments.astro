---
import "../styles/global.css";

import Layout from "../layouts/Layout.astro";
import HeaderSection from "../components/HeaderSection.astro";
import FooterSection from "../components/FooterSection.astro";
import SectionContainer from "../components/SectionContainer.astro";
import { seasons } from "../data/tournaments";
import { TableItem } from "../components/TableItem";

const medal: { [place: number]: string } = {
  1: "🥇",
  2: "🥈",
  3: "🥉",
};

const formatPlacement = (placement?: number, numberOfTeams?: number) =>
  typeof placement === "number" && typeof numberOfTeams === "number"
    ? `${placement}/${numberOfTeams} ${medal[placement] ?? ""}`
    : undefined;
---

<Layout title="Tournaments">
  <HeaderSection id="header" />
  <main class="h-full w-full">
    <SectionContainer id="tournaments">
      <h1 class="mb-6">Tournaments</h1>
      {
        seasons.map((season) => {
          return (
            <div>
              <h2 class="mb-4" id={`${season.year}-${season.season}`}>
                {season.year} {season.season}
              </h2>
              <div class="w-full overflow-x-auto">
                <table
                  class="mb-4 w-full min-w-[1000px] table-fixed border-collapse"
                  aria-labelledby={`${season.year}-${season.season}`}
                >
                  <thead class="border-b-2 border-gray-300">
                    <tr class="text-left">
                      <th scope="col">Name</th>
                      <th scope="col">Place</th>
                      <th scope="col">Date</th>
                      <th scope="col">Final placement</th>
                      <th scope="col">Spirit placement</th>
                      <th scope="col">Scores</th>
                      <th scope="col">Media</th>
                    </tr>
                  </thead>
                  <tbody>
                    {season.tournaments.map(
                      ({ name, place, date, placements, links }) => {
                        const finalPlacementText = formatPlacement(
                          placements?.finalPlacement,
                          placements?.numberOfTeams,
                        );
                        const spiritPlacementText = formatPlacement(
                          placements?.spirit,
                          placements?.numberOfTeams,
                        );
                        return (
                          <tr class="border-b border-gray-300">
                            <TableItem title={name}>{name}</TableItem>
                            <TableItem title={place}>{place}</TableItem>
                            <TableItem title={date}>{date}</TableItem>
                            <TableItem title={finalPlacementText}>
                              {finalPlacementText}
                            </TableItem>
                            <TableItem title={spiritPlacementText}>
                              {spiritPlacementText}
                            </TableItem>
                            <TableItem>
                              {links?.scores?.games && (
                                <a
                                  class="underline hover:no-underline"
                                  href={links.scores.games}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                >
                                  Games
                                </a>
                              )}
                              {links?.scores?.spirit && (
                                <a
                                  class="underline hover:no-underline"
                                  href={links.scores.spirit}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                >
                                  Spirit
                                </a>
                              )}
                            </TableItem>
                            <TableItem>
                              {links?.media &&
                                links.media.map((link, index, array) => (
                                  <>
                                    <a
                                      class="underline hover:no-underline"
                                      href={link}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                    >
                                      {index + 1}
                                    </a>
                                    {index !== array.length - 1 && "|"}
                                  </>
                                ))}
                            </TableItem>
                          </tr>
                        );
                      },
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          );
        })
      }
      <br />
      <p>
        Missing/incorrect information on this page? Please <a
          class="underline hover:no-underline"
          href="/#contact">contact us</a
        >!
      </p>
    </SectionContainer>
  </main>
  <FooterSection />
</Layout>
