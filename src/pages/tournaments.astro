---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import HeaderSection from "../components/HeaderSection.astro";
import FooterSection from "../components/FooterSection.astro";
import SectionContainer from "../components/SectionContainer.astro";
import { seasons } from "../data/tournaments";

const DataNotAvailable = "N/A";

const PlacementTr = (placement?: number, numberOfTeams?: number) =>
  typeof placement === "number" && typeof numberOfTeams === "number"
    ? `${placement}/${numberOfTeams}`
    : DataNotAvailable;
---

<Layout title="Tournaments">
  <main class="h-full w-full">
    <HeaderSection id="header" />

    <SectionContainer id="tournaments">
      <h1 class="mb-6">Tournaments</h1>

      {
        seasons.map((season) => {
          return (
            <div>
              <h2 class="mb-4" id={`${season.year}-${season.season}`}>
                {season.year} {season.season}
              </h2>
              <div class="w-full overflow-x-auto">
                <table
                  class="mb-4 w-4/5 min-w-[750px] table-auto border-collapse"
                  aria-labelledby={`${season.year}-${season.season}`}
                >
                  <thead class="border-b-2 border-gray-300">
                    <tr class="text-left">
                      <th>Name</th> <th>Place</th>
                      <th>Date</th>
                      <th>Final placement</th>
                      <th>Spirit placement</th>
                      <th>Scores</th>
                      <th>Media</th>
                    </tr>
                  </thead>
                  <tbody>
                    {season.tournaments.map(
                      ({ name, place, date, placements, links }) => (
                        <tr class="border-b border-gray-300 pb-2">
                          <td>{name}</td>
                          <td>{place}</td>
                          <td>{date}</td>
                          <td>
                            {PlacementTr(
                              placements.finalPlacement,
                              placements.numberOfTeams,
                            )}
                          </td>
                          <td>
                            {PlacementTr(
                              placements.spirit,
                              placements.numberOfTeams,
                            )}
                          </td>
                          <td>
                            {links?.scores ? (
                              <a href={links?.scores}>Link</a>
                            ) : (
                              DataNotAvailable
                            )}
                          </td>
                          <td>
                            {links?.media
                              ? links?.media?.map((link, index) => (
                                  <a href={link}>{index + 1}</a>
                                ))
                              : DataNotAvailable}
                          </td>
                        </tr>
                      ),
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          );
        })
      }
    </SectionContainer>

    <FooterSection />
  </main>
</Layout>
